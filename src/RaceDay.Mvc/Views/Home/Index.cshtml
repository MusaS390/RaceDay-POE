<section class="hero mb-4"><span class="badge text-bg-warning mb-3">YOUR NEXT FINISH LINE STARTS HERE</span><h1 class="display-4">Find your pace.<br/>Own your race.</h1><p class="lead">Discover events, enter races and track every achievement with RaceDay.</p><a class="btn btn-warning btn-lg" asp-controller="Auth" asp-action="Register">Get started</a></section><h3 class="fw-bold mb-3">Upcoming races</h3>@if(ViewBag.ApiError!=null){<div class="alert alert-warning">Connect the Part 2 API to display live events.</div>}<div class="row g-3">@if(ViewBag.Events.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var e in ViewBag.Events.EnumerateArray()){<div class="col-md-4"><div class="card p-3 h-100"><div class="text-primary fw-bold small">RACE EVENT</div><h5 class="fw-bold mt-2">@e.GetProperty("name").GetString()</h5><p class="muted">@e.GetProperty("location").GetString()</p><p>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</p></div></div>}}</div>