@model LoginVm
<div class="row justify-content-center"><div class="col-md-5"><div class="card p-4"><h2 class="fw-bold">Welcome back</h2><p class="muted">Sign in to continue your RaceDay journey.</p><div asp-validation-summary="All" class="text-danger"></div><form method="post">@Html.AntiForgeryToken()<label class="form-label">Email</label><input asp-for="Email" class="form-control mb-3"/><label class="form-label">Password</label><input asp-for="Password" type="password" class="form-control mb-3"/><button class="btn btn-primary w-100">Sign in</button></form><p class="mt-3 mb-0">New here? <a asp-action="Register">Create an account</a></p></div></div></div>