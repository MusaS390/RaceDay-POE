@model RegisterVm
<div class="row justify-content-center"><div class="col-md-6"><div class="card p-4"><h2 class="fw-bold">Create your RaceDay account</h2><div asp-validation-summary="All" class="text-danger"></div><form method="post">@Html.AntiForgeryToken()<label class="form-label">Full name</label><input asp-for="FullName" class="form-control mb-3"/><label class="form-label">Email</label><input asp-for="Email" class="form-control mb-3"/><label class="form-label">Password (8+ characters)</label><input asp-for="Password" type="password" class="form-control mb-3"/><label class="form-label">Account type</label><select asp-for="Role" class="form-select mb-3"><option>Participant</option><option>Organiser</option></select><button class="btn btn-warning w-100">Create account</button></form></div></div></div>