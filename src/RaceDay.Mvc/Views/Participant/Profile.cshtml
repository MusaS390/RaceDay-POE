@model ProfileVm
<div class="row justify-content-center"><div class="col-md-7"><div class="card p-4"><h2 class="fw-bold">My profile</h2><div asp-validation-summary="All" class="text-danger"></div><form method="post">@Html.AntiForgeryToken()<label class="form-label">Full name</label><input asp-for="FullName" class="form-control mb-3"/><label class="form-label">Email</label><input asp-for="Email" class="form-control mb-3"/><button class="btn btn-primary">Save changes</button></form><p class="small muted mt-3">Profile picture upload is pending the Part 2 API Blob Storage upload endpoint.</p></div></div></div>