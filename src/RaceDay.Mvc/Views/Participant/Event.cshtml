@{ var e = (System.Text.Json.JsonElement)ViewBag.Event; }<div class="card p-4 mb-3"><span class="badge text-bg-primary align-self-start">RACE DETAILS</span><h1 class="fw-bold mt-2">@e.GetProperty("name").GetString()</h1><p class="muted">@e.GetProperty("location").GetString() · @e.GetProperty("eventDate").GetDateTime().ToString("dddd, dd MMMM yyyy")</p><p>@(e.TryGetProperty("description",out var d)?d.GetString():"Join us at the start line.")</p></div><h3 class="fw-bold">Choose your category</h3><div class="row g-3">@if(ViewBag.Categories.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var c in ViewBag.Categories.EnumerateArray()){<div class="col-md-4"><div class="card p-3"><h5>@c.GetProperty("name").GetString()</h5><p class="muted">@c.GetProperty("distanceKm").ToString() km · Capacity @c.GetProperty("maxParticipants").ToString()</p><form asp-action="Enter" method="post">@Html.AntiForgeryToken()<input type="hidden" name="categoryId" value="@c.GetProperty("categoryId").GetInt32()"/><label class="form-label small">Emergency contact (optional)</label><input name="emergencyContact" class="form-control mb-2"/><button class="btn btn-warning w-100">Enter event</button></form></div></div>}}</div>