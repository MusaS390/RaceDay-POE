<h2 class="fw-bold">My race entries</h2><div class="card p-3"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th><th></th></tr></thead><tbody>@if(ViewBag.Items.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var x in ViewBag.Items.EnumerateArray()){<tr><td class="fw-bold">@x.GetProperty("eventName").GetString()</td><td>@x.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td><td>@x.GetProperty("categoryName").GetString()</td><td><span class="badge status-confirmed">Confirmed</span></td><td><form asp-action="Cancel" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.GetProperty("enrolmentId").GetInt32()"/><button class="btn btn-sm btn-outline-danger">Cancel</button></form></td></tr>}}</tbody></table></div>