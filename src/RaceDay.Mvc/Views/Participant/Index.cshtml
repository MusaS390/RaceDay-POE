<section class="hero mb-4"><span class="badge text-bg-warning mb-2">READY, SET, RACE</span><h1 class="display-5">Your next challenge<br/>is out there.</h1><p class="lead">Explore upcoming events and secure your place on the start line.</p></section><h3 class="fw-bold">Upcoming events</h3><div class="row g-3">@if(ViewBag.Events.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var e in ViewBag.Events.EnumerateArray()){<div class="col-md-4"><div class="card p-3 h-100"><span class="badge text-bg-primary align-self-start">UPCOMING</span><h5 class="fw-bold mt-2">@e.GetProperty("name").GetString()</h5><p class="muted">@e.GetProperty("location").GetString()</p><p>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</p><a class="btn btn-primary mt-auto" asp-action="Event" asp-route-id="@e.GetProperty("eventId").GetInt32()">View event & enter</a></div></div>}}</div>