<h2 class="fw-bold">My results</h2><p class="muted">Your personal race history.</p><div class="card p-3"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@if(ViewBag.Items.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var x in ViewBag.Items.EnumerateArray()){var result=((List<System.Text.Json.JsonElement>)ViewBag.Results).FirstOrDefault(r=>r.GetProperty("enrolmentId").GetInt32()==x.GetProperty("enrolmentId").GetInt32());if(result.ValueKind!=System.Text.Json.JsonValueKind.Undefined){<tr><td>@x.GetProperty("eventName").GetString()</td><td>@x.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td><td>@x.GetProperty("categoryName").GetString()</td><td>@result.GetProperty("finishTime").ToString()</td><td><strong>@result.GetProperty("position").GetInt32()</strong></td></tr>}}}</tbody></table></div>