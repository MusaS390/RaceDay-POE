<h2 class="fw-bold">Organiser dashboard</h2><p class="muted">Your event control centre.</p><div class="d-flex gap-2 mb-4"><a class="btn btn-warning" asp-action="CreateEvent">＋ Create event</a><a class="btn btn-outline-primary" asp-action="Events">Manage events</a></div><div class="row g-3">@if(ViewBag.Events.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var e in ViewBag.Events.EnumerateArray()){<div class="col-md-4"><div class="card p-3 h-100"><span class="badge text-bg-primary align-self-start">EVENT</span><h5 class="mt-2 fw-bold">@e.GetProperty("name").GetString()</h5><div class="muted">@e.GetProperty("location").GetString()</div><div class="mt-2">@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</div><hr/><div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="Categories" asp-route-id="@e.GetProperty("eventId").GetInt32()">Categories</a><a class="btn btn-sm btn-outline-primary" asp-action="Enrolments" asp-route-id="@e.GetProperty("eventId").GetInt32()">Entries</a><a class="btn btn-sm btn-outline-primary" asp-action="Results" asp-route-id="@e.GetProperty("eventId").GetInt32()">Results</a></div></div></div>}}</div>