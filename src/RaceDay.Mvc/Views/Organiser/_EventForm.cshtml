@model EventVm
<div class="card p-4"><h2 class="fw-bold">@ViewData["Title"]</h2><div asp-validation-summary="All" class="text-danger"></div><form method="post">@Html.AntiForgeryToken()<input asp-for="EventId" type="hidden"/><label class="form-label">Event name</label><input asp-for="Name" class="form-control mb-3"/><label class="form-label">Description</label><textarea asp-for="Description" class="form-control mb-3"></textarea><label class="form-label">Location</label><input asp-for="Location" class="form-control mb-3"/><label class="form-label">Event date</label><input asp-for="EventDate" type="date" class="form-control mb-3"/><button class="btn btn-primary">Save event</button> <a asp-action="Events" class="btn btn-light">Cancel</a></form><p class="small muted mt-3">Distance, event type and banner upload require the corresponding Part 2 API fields/endpoints; see the integration notes in README.</p></div>