<h2 class="fw-bold">Categories · @ViewBag.EventName</h2><div class="row g-3"><div class="col-lg-5"><div class="card p-3"><h5>Add category</h5><form asp-action="AddCategory" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@ViewBag.EventId"/><label class="form-label">Category name</label><input name="Name" class="form-control mb-2" required/><label class="form-label">Distance (km)</label><input name="DistanceKm" type="number" step=".1" min=".1" class="form-control mb-2" required/><label class="form-label">Maximum participants</label><input name="MaxParticipants" type="number" min="1" class="form-control mb-3" value="100" required/><button class="btn btn-primary">Add category</button></form></div></div><div class="col-lg-7"><div class="card p-3"><h5>Available categories</h5><table class="table"><thead><tr><th>Name</th><th>Distance</th><th>Capacity</th></tr></thead><tbody>@if(ViewBag.Categories.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var c in ViewBag.Categories.EnumerateArray()){<tr><td>@c.GetProperty("name").GetString()</td><td>@c.GetProperty("distanceKm").ToString() km</td><td>@c.GetProperty("maxParticipants").ToString()</td></tr>}}</tbody></table></div></div></div>