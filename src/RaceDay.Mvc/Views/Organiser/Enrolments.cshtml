<h2 class="fw-bold">Entries · @ViewBag.EventName</h2><div class="card p-3"><table class="table"><thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Entry date</th><th>Status</th></tr></thead><tbody>@if(ViewBag.Items.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var x in ViewBag.Items.EnumerateArray()){<tr><td>@x.GetProperty("participantName").GetString()</td><td>@x.GetProperty("email").GetString()</td><td>@x.GetProperty("categoryName").GetString()</td><td>@x.GetProperty("enrolmentDate").GetDateTime().ToString("dd MMM yyyy")</td><td><span class="badge status-confirmed">Confirmed</span></td></tr>}}</tbody></table></div>