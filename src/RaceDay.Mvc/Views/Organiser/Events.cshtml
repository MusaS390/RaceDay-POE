<div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="fw-bold">Event management</h2><p class="muted">Create and manage your races.</p></div><a class="btn btn-warning" asp-action="CreateEvent">＋ New event</a></div><div class="card p-3"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Location</th><th>Date</th><th>Manage</th></tr></thead><tbody>@if(ViewBag.Events.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var e in ViewBag.Events.EnumerateArray()){<tr><td class="fw-bold">@e.GetProperty("name").GetString()</td><td>@e.GetProperty("location").GetString()</td><td>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td><td class="d-flex gap-1"><a class="btn btn-sm btn-outline-primary" asp-action="EditEvent" asp-route-id="@e.GetProperty("eventId").GetInt32()">Edit</a><a class="btn btn-sm btn-outline-secondary" asp-action="Categories" asp-route-id="@e.GetProperty("eventId").GetInt32()">Categories</a><form asp-action="DeleteEvent" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.GetProperty("eventId").GetInt32()"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this event?')">Delete</button></form></td></tr>}}</tbody></table></div></div>