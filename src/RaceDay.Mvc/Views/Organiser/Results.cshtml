<h2 class="fw-bold">Results · @ViewBag.EventName</h2><div class="card p-3 mb-3"><h5>Record participant result</h5><form asp-action="SaveResult" method="post" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="eventId" value="@ViewBag.EventId"/><div class="col-md-5"><label class="form-label">Enrolment</label><select name="enrolmentId" class="form-select" required>@if(ViewBag.Enrolments.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var x in ViewBag.Enrolments.EnumerateArray()){<option value="@x.GetProperty("enrolmentId").GetInt32()">@x.GetProperty("participantName").GetString() — @x.GetProperty("categoryName").GetString()</option>}}</select></div><div class="col-md-3"><label class="form-label">Finish time</label><input name="FinishTime" class="form-control" placeholder="00:32:15" required/></div><div class="col-md-2"><label class="form-label">Position</label><input name="Position" type="number" min="1" value="1" class="form-control" required/></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary">Publish</button></div></form></div><div class="card p-3"><h5>Published results</h5><table class="table"><thead><tr><th>Position</th><th>Participant</th><th>Category</th><th>Finish time</th></tr></thead><tbody>@if(ViewBag.Results.ValueKind==System.Text.Json.JsonValueKind.Array){@foreach(var x in ViewBag.Results.EnumerateArray()){<tr><td><strong>@x.GetProperty("position").GetInt32()</strong></td><td>@x.GetProperty("participantName").GetString()</td><td>@x.GetProperty("categoryName").GetString()</td><td>@x.GetProperty("finishTime").ToString()</td></tr>}}</tbody></table></div>